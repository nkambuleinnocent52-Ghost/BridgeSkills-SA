{
  "name": "skillbridge-sa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "reports": "node server/reports.js",
    "dev:web": "vite --host 0.0.0.0"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}

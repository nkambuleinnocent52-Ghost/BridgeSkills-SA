# Local development works without credentials using SQLite.
PORT=3000
SEED_DEMO=true
DATABASE_PATH=./data/skillbridge.sqlite

# For Supabase: copy your transaction pooler URI (port 6543) here privately.
# Use the postgres.PROJECT_REF pooler user from the Supabase Connect dialog.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Optional: root certificate supplied by Supabase, as a PEM string (\n is supported).
# DATABASE_CA_CERT=

# Production: Vercel supplies the production hostname automatically.
# APP_BASE_URL=https://your-project.vercel.app
# NODE_ENV=production

# Optional tests only. Use a disposable local PostgreSQL database, never production.
# TEST_DATABASE_URL=postgresql://postgres:LOCAL_TEST_PASSWORD@127.0.0.1:5432/skillbridge_test
